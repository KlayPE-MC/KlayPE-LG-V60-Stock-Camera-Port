                         __FUNCTION__, streamId);
                 return INVALID_OPERATION;
             }
-            dstStream->setUsage(
-                    mapProducerToFrameworkUsage(src.v3_2.producerUsage));
+            uint64_t producerUsage =
+                    mapProducerToFrameworkUsage(src.v3_2.producerUsage);
+            // Legacy LG camera HAL custom modes may omit the producer usage for
+            // opaque preview outputs. Without a camera-writer bit, gralloc cannot
+            // resolve IMPLEMENTATION_DEFINED to an allocatable format.
+            if (producerUsage == 0 &&
+                    dstStream->getOriginalFormat() ==
